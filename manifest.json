
{
  "manifest_version": 3,
  "name": "Super Lemmy",
  "version": "0.1.6",
  "description": "Classic Reddit-inspired interface for Lemmy",
  "browser_specific_settings": {
  "gecko": {
    "id": "super-lemmy@tangosox.github",
    "update_url": "https://tangosox.github.io/Super-Lemmy/updates.json",
    "data_collection_permissions": {
      "required": ["none"]
    }
  }
},
"host_permissions": [
  "https://lemmy.world/*",
  "https://lemmy.ca/*",
  "https://lemmy.ml/*",
  "https://feddit.org/*"
],
"action": {
  "default_title": "Super Lemmy Settings",
  "default_popup": "popup/popup.html"
},

"permissions": [
  "storage"
],
"content_scripts": [
  {
    "matches": [
      "https://lemmy.world/*",
      "https://lemmy.ca/*",
      "https://lemmy.ml/*",
      "https://feddit.org/*"
    ],
    "css": [
      "src/themes.css",
      "src/frontpage.css",
      "src/comments.css"
    ],
    "run_at": "document_start"
  },
  {
    "matches": [
      "https://lemmy.world/*",
      "https://lemmy.ca/*",
      "https://lemmy.ml/*",
      "https://feddit.org/*"
    ],
    "js": [
      "src/theme.js",
      "vendor/markdown-it.min.js",
      "src/comments.user.js",
      "src/infinite-scroll.user.js"
    ],
    "run_at": "document_start"
  }
]
}
