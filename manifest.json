
{
  "manifest_version": 3,
  "name": "Super Lemmy",
  "version": "0.1.0",
  "description": "Classic Reddit-inspired interface for Lemmy",
  "browser_specific_settings": {
    "gecko": {
      "id": "super-lemmy@tangosox.github"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lemmy.world/*",
        "https://lemmy.ca/*",
        "https://lemmy.ml/*",
        "https://feddit.org/*"
      ],
      "css": [
        "src/frontpage.css",
        "src/comments.css"
      ],
      "js": [
        "vendor/markdown-it.min.js",
        "src/comments.user.js",
        "src/infinite-scroll.user.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

